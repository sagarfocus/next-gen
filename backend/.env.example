# Postgres connection (same DB as the old project)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# JWT signing secret (reuse the old project's value so existing tokens stay valid)
JWT_SECRET="change-me-to-a-long-random-string"

# Server port
PORT=4000

# Allowed CORS origin (the Vite dev server)
FRONTEND_ORIGIN="http://localhost:5173"

# Environment
NODE_ENV="development"
